# Plantilla de entorno — producción (srv-mabuiosapi, Docker)
# Copia una vez en el servidor:
#   cp deploy/env/prod.env.example .env
#   # edita .env con credenciales reales (no commitear)
#
# Alternativa estilo SCNexus: cp a deploy/env/active.env y enlazar:
#   ln -sf deploy/env/active.env .env
#
# Compose (docker-compose.prod.yml) sobrescribe en contenedor:
#   REDIS_URL=redis://redis:6379/0
#   FILE_STORAGE_ENDPOINT=http://192.168.2.211:9100
#   ENVIRONMENT=production
#
# Contraseñas con $ en este archivo: escapar cada $ como $$ para docker compose.
# ODBC en imagen Docker: Driver 18 (ver docs/DEPLOY_DOCKER_PRODUCCION.md).

ENVIRONMENT=production

# --- MBA3 ---
MBA3_BASE_URL=http://192.168.2.159:8081
MBA3_CODIGO=
MBA3_PWD=
MBA3_DIGEST_USERNAME=
MBA3_DIGEST_PASSWORD=

# --- SQL Server (alcanzable desde el contenedor, no localhost del host si la BD es remota) ---
SQL_SERVER_DRIVER={ODBC Driver 18 for SQL Server}
SQL_SERVER_SERVER=
SQL_SERVER_DATABASE=store_control
SQL_SERVER_UID=
SQL_SERVER_PWD=
ENABLE_SQL_SERVER_STORAGE=true

SQL_SERVER_SAP_DRIVER={ODBC Driver 18 for SQL Server}
SQL_SERVER_SAP_SERVER=
SQL_SERVER_SAP_DATABASE=STORECONTROL
SQL_SERVER_SAP_UID=
SQL_SERVER_SAP_PWD=

# --- SAP ---
SAP_LINKED_SERVER=MYHANADB
SAP_DATABASE=
SAP_SCHEMA=
ENABLE_SAP_QUERIES=true
SAP_SERVICE_LAYER_URL=
SAP_SERVICE_LAYER_USERNAME=
SAP_SERVICE_LAYER_PASSWORD=
SAP_SERVICE_LAYER_DATABASE=
ENABLE_SAP_SERVICE_LAYER=true

# --- JWT / Core ---
JWT_SECRET=
JWT_ISSUER=SCNexus.Core
JWT_AUDIENCE=SCNexus.Users
ENABLE_JWT_AUTH=true
CORE_API_URL=

# --- Celery (en Docker el worker usa REDIS_URL del overlay) ---
ENABLE_AUTO_MIGRATE=false

# --- MinIO remoto (srv-mabuiosbdo); el overlay de prod fuerza este endpoint en runtime ---
ENABLE_FILE_STORAGE=true
FILE_STORAGE_ENDPOINT=http://192.168.2.211:9100
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=
FILE_STORAGE_BUCKET=excel-files
FILE_STORAGE_REGION=us-east-1
MAX_EXCEL_UPLOAD_SIZE_MB=50

# --- Email (opcional) ---
ENABLE_EMAIL_NOTIFICATIONS=false
EMAIL_SMTP_SERVER=
EMAIL_SMTP_PORT=25
